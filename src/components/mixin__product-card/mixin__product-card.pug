mixin product-card(args={})
	+include-style('mixin__product-card')
	+include-script('mixin__product-card')

	.product-card-wrap
		.product-card
			.product-card__inner
				.product-card__top
					.product-card__top-badges

						.product-card__badge(title="Рейтинг")
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M7.75254 1.36108C7.8717 1.1872 8.1283 1.1872 8.24746 1.36108L10.7611 5.02872C10.8001 5.08564 10.8575 5.12737 10.9237 5.14688L15.1886 6.40409C15.3908 6.46369 15.4701 6.70773 15.3415 6.87479L12.6301 10.3987C12.588 10.4534 12.5661 10.5209 12.568 10.5899L12.6902 15.0346C12.696 15.2453 12.4885 15.3961 12.2898 15.3255L8.10051 13.8357C8.0355 13.8126 7.9645 13.8126 7.89949 13.8357L3.71015 15.3255C3.51155 15.3961 3.30396 15.2453 3.30975 15.0346L3.432 10.5899C3.43389 10.5209 3.41195 10.4534 3.36987 10.3987L0.658482 6.87479C0.529943 6.70773 0.609236 6.46369 0.811421 6.40409L5.0763 5.14688C5.14249 5.12737 5.19993 5.08564 5.23894 5.02872L7.75254 1.36108Z" fill="#757575"/>
							</svg>

							span 12
						a(href="/html/product.html#tabs" title="Количество отзывов").product-card__badge
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M13.3346 1.33301H2.66797C2.13754 1.33301 1.62883 1.54372 1.25376 1.91879C0.878682 2.29387 0.667969 2.80257 0.667969 3.33301V9.99967C0.667969 10.5301 0.878682 11.0388 1.25376 11.4139C1.62883 11.789 2.13754 11.9997 2.66797 11.9997H4.0013V13.9997C4.00141 14.1305 4.04003 14.2585 4.11234 14.3675C4.18466 14.4766 4.28747 14.562 4.40797 14.613C4.49063 14.6466 4.57876 14.6647 4.66797 14.6663C4.84286 14.6656 5.01046 14.5962 5.13464 14.473L7.6613 11.9997H13.3346C13.8651 11.9997 14.3738 11.789 14.7488 11.4139C15.1239 11.0388 15.3346 10.5301 15.3346 9.99967V3.33301C15.3346 2.80257 15.1239 2.29387 14.7488 1.91879C14.3738 1.54372 13.8651 1.33301 13.3346 1.33301ZM12.0013 8.66634H4.0013V7.33301H12.0013V8.66634ZM12.0013 5.99967H4.0013V4.66634H12.0013V5.99967Z" fill="#757575"/>
							</svg>

							span 23
						.product-card__badge(title="Количество заказов")
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M14.3759 4.02905L7.9986 0.5L5.3995 1.93831L11.795 5.48268L14.3759 4.02905ZM1.17969 4.77407V11.7839L7.55891 15.5001V8.38219L1.17969 4.77407ZM14.8175 4.78951L8.43829 8.38278V15.5001L14.8175 11.7839V4.78951ZM10.8954 5.98944L4.49176 2.44058L1.63505 4.02137L7.99907 7.62082L10.8954 5.98944Z" fill="#757575"/>
							</svg>

							span 32
						//-if(args.badges === 5)
							+lazy-img({
								link: false,
								wrap_mod: 'product-card__badge-wrap',
								img_mod: '.product-card__badge__icon',
								img: `i-present.svg`,
							})
							+lazy-img({
								link: false,
								wrap_mod: 'product-card__badge-wrap',
								img_mod: '.product-card__badge__icon',
								img: `i-good.svg`,
							})
							+lazy-img({
								link: false,
								wrap_mod: 'product-card__badge-wrap',
								img_mod: '.product-card__badge__icon',
								img: `i-sale.svg`,
							})
							+lazy-img({
								link: false,
								wrap_mod: 'product-card__badge-wrap',
								img_mod: '.product-card__badge__icon',
								img: `i-cartt.svg`,
							})
							+lazy-img({
								link: true,
								href: '/html/product.html#tabs',
								wrap_mod: 'product-card__badge-wrap',
								img_mod: '.product-card__badge__icon',
								img: `i-review.svg`,
							})

					.product-card__images
						+lazy-img({
							link: true,
							wrap_mod: 'product-card__img',
							img: 'product-tea.png'
						})
				.product-card__info
					//-.product-card__info-line
						.product-card__rating
							.star.filled(style="width:16px; height: 16px")
							.star.filled(style="width:16px; height: 16px")
							.star.filled(style="width:16px; height: 16px")
							.star.half(style="width:16px; height: 16px")
							.star(style="width:16px; height: 16px")

						//-.product-card__review
							+icon('i-review')(style="height:14px;width:14px")
							span 0
							span отзывов
					a(href="#").product-card__title=args.title
					if(!args.utp)
						.product-card__info-body
							//-.product-card__prices
								.product-card__price-new 45.30 руб.
								if(args.no_price_old)
									.product-card__price-old
										span 48.30 руб.
										.discount
											<svg xmlns="http://www.w3.org/2000/svg" width="4" height="5" viewBox="0 0 4 5" fill="none">
											<path d="M0.5 2.5L3.5 0.334936L3.5 4.66506L0.5 2.5Z" fill="#D64A4A"></path>
											</svg>
											span -10%
							.product-card__grid
								.product-card__grid-title Масса:&nbsp;
									span 100 г.
					else
						.product-block__grid__group
							.product-block__grid__item
								.product-card__grid-title Цвет: <span>Бежевый</span>
								if(args.utp7)
									.utp
										.utp-color(style="--bg-utp:url(/html/images/product-tea.png)").active
										.utp-color(style="--bg-utp:url(/html/images/product.png)")
										.utp-color(style="--bg-utp:url(/html/images/product.png)")
										.utp-color(style="--bg-utp:url(/html/images/product.png)")
										.utp-color(style="--bg-utp:url(/html/images/product.png)")
										//.utp-color(style="--bg-utp:url(/html/images/product-tea.png)")
										.utp-color(style="--bg-utp:red")
										.utp-color(style="--bg-utp:red")
								else
									.utp
										.utp-color(style="--bg-utp:url(/html/images/product-tea.png)").active
										.utp-color(style="--bg-utp:url(/html/images/product.png)")
										//.utp-color(style="--bg-utp:url(/html/images/product-tea.png)")
										.utp-color(style="--bg-utp:red")


							.product-block__grid__item
								.product-card__grid-title Объем
								.utp
									.product-card__grid-property.active
										span 150
									.product-card__grid-property
										span 200
						//-.product-card__prices
							.product-card__price-new 45.30 руб.
							if(args.no_price_old)
								.product-card__price-old
									span 48.30 руб.
									.discount
										<svg xmlns="http://www.w3.org/2000/svg" width="4" height="5" viewBox="0 0 4 5" fill="none">
										<path d="M0.5 2.5L3.5 0.334936L3.5 4.66506L0.5 2.5Z" fill="#D64A4A"></path>
										</svg>
										span -10%

				.product-card__actions
					.product-card__actions-inner
						.product-card__prices
							.product-card__price-new 45.30 руб.
							if(args.no_price_old)
								.product-card__price-old
									span 48.30 руб.
									.discount
										<svg xmlns="http://www.w3.org/2000/svg" width="4" height="5" viewBox="0 0 4 5" fill="none">
										<path d="M0.5 2.5L3.5 0.334936L3.5 4.66506L0.5 2.5Z" fill="#D64A4A"></path>
										</svg>
										span -10%
						//-.product-card__favorite(class= args.active && 'active' )
							<svg width="21" height="21" viewBox="0 0 23 21" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M11.5429 4.18922C9.61684 1.90451 6.40498 1.28993 3.99174 3.38204C1.5785 5.47414 1.23875 8.97204 3.13388 11.4464C4.70955 13.5036 9.47809 17.8425 11.041 19.2469C11.2158 19.404 11.3032 19.4825 11.4052 19.5134C11.4942 19.5403 11.5916 19.5403 11.6806 19.5134C11.7826 19.4825 11.87 19.404 12.0449 19.2469C13.6077 17.8425 18.3763 13.5036 19.9519 11.4464C21.8471 8.97204 21.5488 5.45213 19.0941 3.38204C16.6394 1.31194 13.469 1.90451 11.5429 4.18922Z" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						if(args.in_basket)
							.product-card__btns
								.product-card__buy.btn.btn-sm.btn-wave
									<svg width="15" height="15" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M14.5211 7.42233V4.6699C14.5211 2.64307 12.8175 1 10.716 1C8.61453 1 6.91093 2.64307 6.91093 4.6699V7.42233M2.71772 8.66273L2.14695 14.5346C1.98467 16.2041 1.90353 17.0389 2.19076 17.6836C2.44308 18.25 2.88525 18.7184 3.44641 19.0135C4.0852 19.3495 4.95451 19.3495 6.69313 19.3495H14.7389C16.4775 19.3495 17.3468 19.3495 17.9856 19.0135C18.5468 18.7184 18.989 18.25 19.2413 17.6836C19.5285 17.0389 19.4474 16.2041 19.2851 14.5346L18.7143 8.66273C18.5773 7.25292 18.5088 6.54801 18.18 6.01507C17.8905 5.54571 17.4628 5.17003 16.9512 4.93583C16.3704 4.6699 15.6363 4.6699 14.1681 4.6699L7.2639 4.6699C5.79574 4.6699 5.06166 4.6699 4.48082 4.93583C3.96927 5.17003 3.54152 5.54571 3.25201 6.01507C2.92328 6.54801 2.85476 7.25291 2.71772 8.66273Z" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
									span Купить
						else
							.product-card__btns
								.counter.btn-wave
									span.counter__action.counter__action--minus
									input.counter__count(type="text" value="1" maxlength="6")
									span.counter__action.counter__action--plus
