+include-style('about-slider')
+include-script('about-slider')


.about-slider
	.container
		.about-slider__inner
			.about-slider__slider
				+splide({
					mod: 'about-slider__main'
				})
					each item in [0,1,2,3,4,4,2,3,1]
						+splide-slide()
							img(src=`/html/images/blog-${item}.jpg` alt='brand')
				+splide({
					mod: 'about-slider__thumbnail'
				})
					each item in [0,1,2,3,4,4,2,3,1]
						+splide-slide()
							img(src=`/html/images/blog-${item}.jpg` alt='brand')

			.about-slider__content
				h3 Про производство
				p В сердце Черногради мы создали уникальное производство, где энергия, креатив и мастерство сливаются воедино. Здесь, на наших мощных ростерах — двух легендарных GIESEN W3OA и одном не менее грозном GIESEN W6A — рождаются истинные произведения искусства, способные зажечь даже самые требовательные вкусы.
				p Но это еще не все! Наш секрет — колосортер, который доводит процесс до совершенства, превращая каждое зернышко в истинное наслаждение. Он убирает все нежелаемые излишки и делает кофе чистым и незабываемым. Мы не просто обжариваем кофе — мы дарим каждой партии неповторимый характер и дерзость, заставляя вас почувствовать всю страсть и тепло, с которым мы работаем каждый день.