							.ny-present__content
								.h4 простота
								p Подарки под ключ.
								p Мы берём на себя всё: от стильной упаковки до доставки крупного тиража


					.ny-present__img
						img(src=SITE_TEMPLATE_PATH+"images/ny-p.webp" loading="lazy")

	section.section.section-4.section--sec
		.ny-form__img
			img(src=SITE_TEMPLATE_PATH + "images/ny-branch.webp" loading="lazy")

		.container
			.ny-form
				.h3 оставить заявку
				p Оформите заявку на сайте, мы свяжемся с вами в ближайшее время и ответим на все интересующие вопросы!
				form.ny-form__grid
					+input({

						type: 'email',
						label_mod: 'form-control-label--small',
						fg_mod: 'form-group--margin',
						name: false,
						small: false,
						placeholder: 'example@example.com',
						required: true,
						pattern: '[A-Za-zА-Яа-я0-9\_\-]{1,}@[A-Za-zА-Яа-я0-9\_\-]{1,}\.[A-Za-zА-Яа-я0-9]{2,}',
						validation: {
							message: 'Заполните поле',
							regexp: 'Неверный формат',
							emailaddress: ' ',
							identical: false
						}
					})
					+input({

						fg_mod: 'form-group--margin',
						label_mod: 'form-control-label--small',
						type: 'tel',
						name: false,
						small: false,
						placeholder: '+375 (__) ___-__-__',
						required: true,
						pattern: 'phone',
						validation: {
							message: 'Заполните поле',
							regexp: 'Неверный формат',
							emailaddress: ' ',
							identical: false
						}
					})
					button(type="submit").ny-btn.ny-btn--red.btn--fw Отправить
