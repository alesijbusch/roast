+include-style('ny')

section.section


	.ny-hero
		picture.ny-hero__img
			source(srcset=SITE_TEMPLATE_PATH + 'images/ny-hero.webp' media="(min-width: 575px)")
			source(srcset=SITE_TEMPLATE_PATH + 'images/ny-hero-mob.webp' media="(min-width: 0)")
			img(src=SITE_TEMPLATE_PATH + 'images/ny-hero')
		.container
			.ny-hero__bottom
				.h3 идеальные подарки
				.h4 для клиентов, партнеров и сотрудников
.sections
	section.section.section-1.section--red
		.section-1__img
			img(src=SITE_TEMPLATE_PATH + "images/ny-branch.webp" loading="lazy")


		.container
				.ny-block
					.ny-block__img
						img(src=SITE_TEMPLATE_PATH+"images/ny-1.webp" loading="lazy")
					.ny-block__content
						.h3 новогодний бокс #1
						.ny-text
							p Нежный и душистый чай, ароматные дрип-пакеты в праздничной новогодней упаковке, открытка — маленькая радость для уютного зимнего утра. 
							p Состав: чай (100 гр), коробка дрип пакетов, открытка
						.ny-btn.ny-btn--sec
							span получить прайс
	section.section.section-2.section--sec
		.container
			.ny-block
				.ny-block__content
					.h3 новогодний бокс #2
					.ny-text
						p Ароматный чай, 200 г свежего кофе, дрип-пакеты в праздничной упаковке и открытка — сочетание, которое подарит вкусное настроение и праздничный уют каждому кофеману. 

						p Состав: чай (100 гр), коробка дрип пакетов, пачка кофе (200 гр), открытка
					.ny-btn.ny-btn--red
						span получить прайс
				.ny-block__img
					img(src=SITE_TEMPLATE_PATH+"images/ny-2.webp" loading="lazy")
	section.section.section-3.section--red
		.container
			.ny-block
				.ny-block__img
					img(src=SITE_TEMPLATE_PATH+"images/ny-3.webp" loading="lazy")
				.ny-block__content
					.h3 новогодний бокс #3
					.ny-text
						p Душистый чай, две пачки свежего кофе по 200 г, дрип-пакеты в новогодней упаковке и открытка — полный набор для настоящего кофейного волшебства. Идеально для ценителей ароматного кофе и праздничного настроения, чтобы этот Новый год стал особенно вкусным.

						p Состав: чай (100 гр), коробка дрип пакетов, пачка кофе (200 гр) (2 шт), открытка
					.ny-btn.ny-btn--sec
						span получить прайс
	section.section-p.section
		.section-p__img
			img(src=SITE_TEMPLATE_PATH + "images/ny-b-2.webp" loading="lazy")

		.container
				.ny-present
					.ny-present__left
						.h3 подарки от roast это:

